# Banco de dados local
DATABASE_URL=postgresql://campax_local:SENHA_AQUI@localhost:5432/campax

# Auth
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Service
PORT=3003

# CORS - origens do frontend, separadas por vírgula
FRONTEND_ORIGIN=http://localhost:8080

# Subdomínios por funerária (spec 08): https://<slug>.<BASE_DOMAIN>. Vazio = desligado.
BASE_DOMAIN=campax.com.br

# mediamtx-sync (webhook de sincronização imediata; só escuta em 127.0.0.1)
MEDIAMTX_SYNC_URL=http://127.0.0.1:3002

# Autenticação HTTP do MediaMTX (spec 06, parte B)
MEDIAMTX_AUTH_KEY=troque-por-um-valor-aleatorio
MEDIAMTX_API_USER=
MEDIAMTX_API_PASSWORD=
# STREAM_MARGIN_MINUTES=30
# STREAM_TOKEN_TTL=4h
