# Copie para .env.test — nunca aponte para o banco de produção (`campax`).
# Crie/atualize o banco com: backend/scripts/refresh-dev-db.sh test
DATABASE_URL="postgresql://campax_local:SENHA@localhost:5432/campax_test"
JWT_SECRET="troque-por-um-valor-aleatorio"
JWT_EXPIRES_IN=1h
FRONTEND_ORIGIN=http://localhost:8080

# Subdomínios por funerária (spec 08): https://<slug>.<BASE_DOMAIN>. Vazio = desligado — os testes definem o valor sozinhos.
BASE_DOMAIN=

MEDIAMTX_AUTH_KEY=troque-por-um-valor-aleatorio
MEDIAMTX_API_USER=api-teste
MEDIAMTX_API_PASSWORD=senha-api-teste
