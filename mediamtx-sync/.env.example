# Banco de dados local (mesmo Postgres usado pelo backend/)
DATABASE_URL=postgresql://campax_local:SENHA_AQUI@localhost:5432/campax

# MediaMTX (roda na mesma VPS)
# API usa HTTP (não suporta SSL direto)
MEDIAMTX_BASE_URL=http://localhost
MEDIAMTX_API_PORT=9997
# WebRTC usa HTTPS através de reverse proxy (sem porta na URL); vai para cameras.webrtc_url.
# Vazio = usa MEDIAMTX_BASE_URL
MEDIAMTX_WEBRTC_BASE_URL=https://media2.campax.com.br
MEDIAMTX_USER=my_admin
MEDIAMTX_PASSWORD=my_password

# Service
PORT=3002
SYNC_INTERVAL=30000
